<view class="container"><block wx:if="{{!loading}}"><view class="card"><view class="row"><text class="label">车牌号</text><text class="value strong">{{data.carNumber||'-'}}</text></view><view class="row"><text class="label">车主姓名</text><text class="value">{{data.owner||'-'}}</text></view><view class="row"><text class="label">联系方式</text><text class="value">{{data.ownerphone||'-'}}</text></view><view class="row"><text class="label">车类型</text><text class="value">{{data.carType||'-'}}</text></view><view class="row"><text class="label">车辆品牌</text><text class="value">{{data.brand||'-'}}</text></view><view class="row"><text class="label">发动机号</text><text class="value">{{data.engineNumber||'-'}}</text></view><view class="row"><text class="label">车架号</text><text class="value">{{data.frame||'-'}}</text></view><view class="row"><text class="label">保险到期</text><text class="value">{{$root.m0}}</text></view><view class="row"><text class="label">其他说明</text><text class="value">{{data.other||'-'}}</text></view></view></block><view class="btns"><button type="primary" data-event-opts="{{[['tap',[['handleUpdate',['$event']]]]]}}" bindtap="__e">修改</button><button class="btn-delete" type="warn" data-event-opts="{{[['tap',[['handleDelete',['$event']]]]]}}" bindtap="__e">删除</button></view></view>