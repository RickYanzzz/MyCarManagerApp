.container{padding:12px;background-color:#f4f8fb;min-height:100vh;box-sizing:border-box}.card{background-color:#fff;border-radius:8px;padding:4px 14px}.row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f0f0f0}.row:last-child{border-bottom:none}.label{font-size:14px;color:#999}.value{font-size:14px;color:#333;max-width:60%;text-align:right}.value.strong{font-size:16px;font-weight:600}.btns{margin-top:16px;display:flex;flex-direction:row}.btns button{flex:1}.btn-delete{margin-left:10px}