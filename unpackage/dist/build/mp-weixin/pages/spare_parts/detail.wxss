.sp-page{background-color:#f4f8fb;min-height:100vh}.sp-scroll{height:calc(100vh - 88px);box-sizing:border-box}.sp-card{background-color:#fff;border-radius:8px;margin:12px;padding:14px}.sp-head{display:flex;justify-content:space-between;align-items:center}.sp-code{font-size:12px;color:#999}.sp-status{font-size:12px;color:#52c41a;background-color:#f0fff0;padding:2px 8px;border-radius:10px}.sp-status.danger{color:#ff4d4f;background-color:#fff1f0}.sp-status.disabled{color:#999;background-color:#f5f5f5}.sp-name{margin-top:8px;font-size:20px;font-weight:600;color:#333}.sp-spec{margin-top:4px;font-size:13px;color:#999}.sp-stock-row{display:flex;margin-top:16px}.sp-stock-item{flex:1;background-color:#f8faff;border-radius:6px;padding:10px;margin-right:10px}.sp-stock-item:last-child{margin-right:0}.sp-stock-num{display:block;font-size:24px;font-weight:600;color:#6ea0f7}.sp-stock-num.danger{color:#ff4d4f}.sp-stock-label{display:block;margin-top:4px;font-size:12px;color:#999}.sp-info-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f0f0f0;font-size:14px;color:#333}.sp-info-label{color:#999}.sp-actions{display:flex;flex-wrap:wrap;margin:0 12px 12px}.sp-btn{margin:0 8px 8px 0;min-width:72px;font-size:13px;background-color:#fff;color:#333;border:1px solid #e4e7ec}.sp-btn.primary{background-color:#6ea0f7;color:#fff;border-color:#6ea0f7}.sp-btn.danger{color:#ff4d4f;border-color:#ffd6d6}.sp-section-title{margin:6px 14px;font-size:15px;font-weight:600;color:#333}.sp-log-list{margin:0 12px}.sp-log-item{background-color:#fff;border-radius:8px;padding:12px 14px;margin-bottom:8px}.sp-log-head{display:flex;justify-content:space-between;align-items:center}.sp-log-type{font-size:13px;color:#6ea0f7}.sp-log-type.out{color:#cc71bf}.sp-log-type.return{color:#52c41a}.sp-log-qty{font-size:16px;font-weight:600}.sp-log-qty.plus{color:#52c41a}.sp-log-qty.minus{color:#ff4d4f}.sp-log-meta{display:flex;justify-content:space-between;margin-top:6px;font-size:12px;color:#999}.sp-log-remark{margin-top:4px;font-size:12px;color:#666}.sp-empty{padding:30px 0;text-align:center;color:#999;font-size:14px}.sp-bottom-space{height:40px}.sp-popup{width:300px;background-color:#fff;border-radius:10px;padding:18px}.sp-popup-title{font-size:17px;font-weight:600;color:#333;text-align:center;margin-bottom:14px}.sp-popup-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;font-size:14px;color:#333}.sp-popup-row > text{width:80px;color:#666}.sp-popup-btns{display:flex;justify-content:space-between;margin-top:8px}.sp-popup-btns .sp-btn{width:120px;margin:0}