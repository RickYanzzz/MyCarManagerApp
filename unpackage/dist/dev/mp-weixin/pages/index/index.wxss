.my-content {
  background-color: #F4F8FB;
}
.container {
  padding: 20px;
  font-size: 20px;
  line-height: 24px;
}
.header-left {
  text-align: center;
}
.header-mid {
  background: #fff;
  height: 80px;
  width: 1px;
}
.header-right {
  text-align: center;
}
.module-content {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 10px;
}
.text-color1 {
  color: #fff;
  font-size: 16px;
}
.text-color2 {
  color: #F2F391;
  font-size: 24px;
}
.text-color3 {
  margin-left: 10px;
  color: #fff;
  font-size: 14px;
}
.header {
  background-color: #6EA0F7;
  height: 130px;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-radius: 5px;
  margin: 0 20px;
}
.my-section {
  border-bottom: 1px solid #E4E7EC;
  background-color: #F4F8FB;
  padding-bottom: 30px;
}
.loginout-btn {
  padding: 30px;
  margin-top: 60px;
}
