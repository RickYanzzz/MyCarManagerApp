<view class="analytics-page data-v-befcedd4"><view class="range-bar data-v-befcedd4"><block wx:for="{{rangeOptions}}" wx:for-item="item" wx:for-index="__i0__" wx:key="*this"><view data-event-opts="{{[['tap',[['onSwitchRange',['$0'],[[['rangeOptions','',__i0__]]]]]]]}}" class="{{['range-item','data-v-befcedd4',(item===range)?'range-item--active':'']}}" bindtap="__e"><text class="{{['range-text','data-v-befcedd4',(item===range)?'range-text--active':'']}}">{{item+"天"}}</text></view></block></view><block wx:if="{{status==='loading'}}"><view class="skeleton-wrap data-v-befcedd4"><view class="skeleton skeleton--hero data-v-befcedd4"></view><view class="skeleton-row data-v-befcedd4"><view class="skeleton skeleton--half data-v-befcedd4"></view><view class="skeleton skeleton--half data-v-befcedd4"></view></view><view class="skeleton skeleton--chart data-v-befcedd4"></view><view class="skeleton skeleton--chart data-v-befcedd4"></view></view></block><block wx:else><block wx:if="{{status==='error'}}"><view class="state-box data-v-befcedd4"><text class="state-title data-v-befcedd4">数据加载失败</text><text class="state-desc data-v-befcedd4">{{errorMessage||'请检查网络后重试'}}</text><button data-event-opts="{{[['tap',[['loadData',['$event']]]]]}}" class="state-btn data-v-befcedd4" bindtap="__e">重新加载</button></view></block><block wx:else><block class="data-v-befcedd4"><view class="hero-card data-v-befcedd4"><view class="hero-head data-v-befcedd4"><text class="hero-label data-v-befcedd4">已入账订单金额</text><text class="hero-date data-v-befcedd4">{{dateRangeText}}</text></view><view class="hero-value-row data-v-befcedd4"><text class="hero-currency data-v-befcedd4">¥</text><text class="hero-value data-v-befcedd4">{{totalAmountText}}</text></view><view class="hero-foot data-v-befcedd4"><text class="hero-foot-text data-v-befcedd4">{{"其中赠送 ¥"+giftText+"，未计入上述金额"}}</text></view></view><view class="sub-row data-v-befcedd4"><view class="sub-card data-v-befcedd4"><text class="sub-label data-v-befcedd4">已入账工单</text><view class="sub-value-row data-v-befcedd4"><text class="sub-value data-v-befcedd4">{{summary.totalOrders}}</text><text class="sub-unit data-v-befcedd4">单</text></view></view><view class="sub-card sub-card--right data-v-befcedd4"><text class="sub-label data-v-befcedd4">平均每单</text><view class="sub-value-row data-v-befcedd4"><text class="sub-currency data-v-befcedd4">¥</text><text class="sub-value data-v-befcedd4">{{avgText}}</text></view></view></view><view class="notice data-v-befcedd4"><text class="notice-title data-v-befcedd4">统计口径</text><text class="notice-item data-v-befcedd4">· 仅统计「已入账」订单，按订单最后一次状态变更时间归集到北京时间自然日</text><text class="notice-item data-v-befcedd4">· 该时间为结算时间的近似值，订单后续被修改状态时会随之变动</text><text class="notice-item data-v-befcedd4">· 本页展示的是「已入账订单金额」，不等于实际到账金额</text><text class="notice-item data-v-befcedd4">· 赠送金额不计入，系统无退款与成本数据，故不展示毛利/净利</text></view><block wx:if="{{isEmpty}}"><view class="state-box state-box--inline data-v-befcedd4"><text class="state-title data-v-befcedd4">该时间段暂无已入账订单</text><text class="state-desc data-v-befcedd4">换个时间段看看，或先在「消费开单」中完成结算</text></view></block><block wx:else><block class="data-v-befcedd4"><view class="chart-card data-v-befcedd4"><view class="chart-head data-v-befcedd4"><text class="chart-title data-v-befcedd4">每日收入趋势</text><text class="chart-sub data-v-befcedd4">单位：元</text></view><view class="chart-body data-v-befcedd4"><qiun-data-charts vue-id="bd56369c-1" type="line" chartData="{{lineData}}" opts="{{optsLine}}" canvasId="analyticsLine" canvas2d="{{true}}" ontouch="{{true}}" animation="{{true}}" class="data-v-befcedd4" bind:__l="__l"></qiun-data-charts></view></view><view class="chart-card data-v-befcedd4"><view class="chart-head data-v-befcedd4"><text class="chart-title data-v-befcedd4">每日工单数量</text><text class="chart-sub data-v-befcedd4">单位：单</text></view><view class="chart-body data-v-befcedd4"><qiun-data-charts vue-id="bd56369c-2" type="column" chartData="{{columnData}}" opts="{{optsColumn}}" canvasId="analyticsColumn" canvas2d="{{true}}" ontouch="{{true}}" animation="{{true}}" class="data-v-befcedd4" bind:__l="__l"></qiun-data-charts></view></view><view class="chart-card data-v-befcedd4"><view class="chart-head data-v-befcedd4"><text class="chart-title data-v-befcedd4">收款方式占比</text><text class="chart-sub data-v-befcedd4">按金额</text></view><view class="chart-body chart-body--ring data-v-befcedd4"><block wx:if="{{hasRingData}}"><qiun-data-charts vue-id="bd56369c-3" type="ring" chartData="{{ringData}}" opts="{{optsRing}}" canvasId="analyticsRing" canvas2d="{{true}}" ontouch="{{true}}" animation="{{true}}" class="data-v-befcedd4" bind:__l="__l"></qiun-data-charts></block><block wx:else><view class="chart-empty data-v-befcedd4"><text class="chart-empty-text data-v-befcedd4">暂无收款记录</text></view></block></view><block wx:if="{{hasRingData}}"><view class="type-list data-v-befcedd4"><block wx:for="{{payTypeList}}" wx:for-item="item" wx:for-index="__i1__" wx:key="type"><view class="type-item data-v-befcedd4"><view class="type-dot data-v-befcedd4" style="{{'background-color:'+(item.color)+';'}}"></view><text class="type-name data-v-befcedd4">{{item.label}}</text><text class="type-amount data-v-befcedd4">{{"¥"+item.amountText}}</text><text class="type-ratio data-v-befcedd4">{{item.ratioText}}</text></view></block></view></block></view></block></block><block wx:if="{{isMock}}"><view class="mock-tip data-v-befcedd4"><text class="mock-tip-text data-v-befcedd4">当前为本地模拟数据（云函数未部署），非门店真实经营数据</text></view></block><view class="bottom-space data-v-befcedd4"></view></block></block></block></view>