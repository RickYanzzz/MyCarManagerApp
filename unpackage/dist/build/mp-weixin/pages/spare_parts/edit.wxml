<view class="sp-page"><nav-header vue-id="5e865e0c-1" type="spareParts" title="{{isEdit?'编辑备件':'新增备件'}}" bind:__l="__l"></nav-header><scroll-view class="sp-scroll" scroll-y="true"><view class="sp-form"><block wx:if="{{isEdit}}"><view class="sp-field"><text class="sp-label">备件编号</text><text class="sp-readonly">{{form.code}}</text></view></block><view class="sp-field"><text class="sp-label">名称 <text class="sp-required">*</text></text><uni-easyinput bind:input="__e" vue-id="5e865e0c-2" placeholder="如：机油滤清器" value="{{form.name}}" data-event-opts="{{[['^input',[['__set_model',['$0','name','$event',[]],['form']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-field"><text class="sp-label">规格/型号</text><uni-easyinput bind:input="__e" vue-id="5e865e0c-3" placeholder="如：JX-001" value="{{form.spec}}" data-event-opts="{{[['^input',[['__set_model',['$0','spec','$event',[]],['form']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-field"><text class="sp-label">单位 <text class="sp-required">*</text></text><uni-easyinput bind:input="__e" vue-id="5e865e0c-4" placeholder="个 / 件 / 套 / 桶" value="{{form.unit}}" data-event-opts="{{[['^input',[['__set_model',['$0','unit','$event',[]],['form']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-field"><text class="sp-label">安全库存</text><uni-easyinput bind:input="__e" vue-id="5e865e0c-5" type="number" placeholder="低于该值预警" value="{{form.safetyStock}}" data-event-opts="{{[['^input',[['__set_model',['$0','safetyStock','$event',[]],['form']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-field"><text class="sp-label">仓位</text><uni-easyinput bind:input="__e" vue-id="5e865e0c-6" placeholder="如：A-01" value="{{form.location}}" data-event-opts="{{[['^input',[['__set_model',['$0','location','$event',[]],['form']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-field"><text class="sp-label">供应商</text><uni-easyinput bind:input="__e" vue-id="5e865e0c-7" placeholder="默认供应商" value="{{form.supplier}}" data-event-opts="{{[['^input',[['__set_model',['$0','supplier','$event',[]],['form']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-field"><text class="sp-label">成本价（元）</text><uni-easyinput bind:input="__e" vue-id="5e865e0c-8" type="number" placeholder="采购成本" value="{{form.costPrice}}" data-event-opts="{{[['^input',[['__set_model',['$0','costPrice','$event',[]],['form']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-field"><text class="sp-label">销售价（元）</text><uni-easyinput bind:input="__e" vue-id="5e865e0c-9" type="number" placeholder="出库计入工单的单价" value="{{form.salePrice}}" data-event-opts="{{[['^input',[['__set_model',['$0','salePrice','$event',[]],['form']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-tip"><block wx:if="{{!isEdit}}"><text>新增后备件库存为 0，请在详情页做入库。</text></block><block wx:else><text>{{"当前库存 "+form.stock+" "+form.unit+"，请通过入库/盘点调整。"}}</text></block></view></view><view class="sp-submit-wrap"><button class="sp-submit" type="primary" data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" bindtap="__e">{{isEdit?'保存修改':'创建备件'}}</button></view><view class="sp-bottom-space"></view></scroll-view></view>