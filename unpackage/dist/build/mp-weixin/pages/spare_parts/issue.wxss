.sp-page{background-color:#f4f8fb;min-height:100vh}.sp-order-info{margin:12px;padding:12px 14px;background-color:#fff;border-radius:8px}.sp-order-title{display:block;font-size:16px;color:#333;font-weight:500}.sp-order-sub{display:block;margin-top:6px;font-size:12px;color:#999}.sp-search{padding:0 12px 6px}.sp-list{height:calc(100vh - 260px);padding:0 12px;box-sizing:border-box}.sp-item{display:flex;align-items:center;background-color:#fff;border-radius:8px;padding:12px 14px;margin-bottom:8px;border:1px solid transparent}.sp-item.selected{border-color:#6ea0f7;background-color:#f7faff}.sp-item.disabled{opacity:.5}.sp-check{width:22px;height:22px;line-height:22px;text-align:center;border-radius:50%;border:1px solid #d9d9d9;color:#fff;font-size:13px;margin-right:10px}.sp-item.selected .sp-check{background-color:#6ea0f7;border-color:#6ea0f7}.sp-info{flex:1;min-width:0}.sp-name{font-size:15px;color:#333}.sp-spec{margin-left:8px;font-size:12px;color:#999}.sp-meta{display:flex;flex-wrap:wrap;margin-top:6px;font-size:12px;color:#999}.sp-meta text{margin-right:14px}.sp-qty{margin-left:8px}.sp-soldout{font-size:12px;color:#ff4d4f;margin-left:8px}.sp-empty{padding:60px 0;text-align:center;color:#999;font-size:14px}.sp-bottom-space{height:90px}.sp-footer{position:fixed;left:0;right:0;bottom:0;background-color:#fff;padding:10px 12px calc(10px + env(safe-area-inset-bottom));display:flex;align-items:center;box-shadow:0 -2px 8px rgba(0,0,0,.05)}.sp-footer-info{flex:1}.sp-footer-count{display:block;font-size:12px;color:#999}.sp-footer-total{display:block;margin-top:2px;font-size:18px;font-weight:600;color:#ff4d4f}.sp-submit{width:120px;background-color:#6ea0f7;font-size:14px;margin:0}