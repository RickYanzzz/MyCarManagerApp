.sp-page{background-color:#f4f8fb;min-height:100vh}.sp-toolbar{padding:10px 12px 4px}.sp-toolbar-row{display:flex;justify-content:space-between;align-items:center;padding:8px 4px 0}.sp-filter,
.sp-reset{font-size:13px;color:#6ea0f7}.sp-filter.active{color:#e6aa46}.sp-summary{margin:8px 12px 0;padding:10px 12px;background-color:#fff4e5;border-radius:6px;display:flex;justify-content:space-between;align-items:center}.sp-summary-text{color:#e6aa46;font-size:14px}.sp-summary-arrow{color:#e6aa46;font-size:12px}.sp-list{height:calc(100vh - 170px);padding:10px 12px 0;box-sizing:border-box}.sp-item{background-color:#fff;border-radius:8px;padding:12px 14px;margin-bottom:10px}.sp-item-head{display:flex;justify-content:space-between;align-items:center}.sp-code{font-size:12px;color:#999}.sp-status{font-size:12px;color:#52c41a;background-color:#f0fff0;padding:2px 8px;border-radius:10px}.sp-status.danger{color:#ff4d4f;background-color:#fff1f0}.sp-name{margin-top:8px;font-size:16px;color:#333;font-weight:500}.sp-spec{margin-left:8px;font-size:13px;color:#999;font-weight:400}.sp-meta{margin-top:8px;display:flex;flex-wrap:wrap;font-size:12px;color:#666}.sp-meta text{margin-right:16px}.sp-empty{padding:80px 0;text-align:center;color:#999;font-size:14px}.sp-bottom-space{height:80px}