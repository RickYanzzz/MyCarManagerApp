<view class="sp-page"><nav-header vue-id="0d7ae3b6-1" type="spareParts" title="{{part.name||'备件详情'}}" bind:__l="__l"></nav-header><scroll-view class="sp-scroll" scroll-y="true"><view class="sp-card"><view class="sp-head"><text class="sp-code">{{part.code}}</text><text class="{{['sp-status',(isLowStock)?'danger':'',(part.status==0)?'disabled':'']}}">{{''+(part.status==0?'已停用':isLowStock?'库存不足':'正常')+''}}</text></view><view class="sp-name">{{part.name}}</view><block wx:if="{{part.spec}}"><view class="sp-spec">{{part.spec}}</view></block><view class="sp-stock-row"><view class="sp-stock-item"><text class="{{['sp-stock-num',(isLowStock)?'danger':'']}}">{{part.stock}}</text><text class="sp-stock-label">{{"当前库存（"+part.unit+"）"}}</text></view><view class="sp-stock-item"><text class="sp-stock-num">{{part.safetyStock}}</text><text class="sp-stock-label">安全库存</text></view></view><view class="sp-info-row"><text class="sp-info-label">仓位</text><text>{{part.location||'-'}}</text></view><view class="sp-info-row"><text class="sp-info-label">供应商</text><text>{{part.supplier||'-'}}</text></view><view class="sp-info-row"><text class="sp-info-label">成本价</text><text>{{"¥"+(part.costPrice||0)}}</text></view><view class="sp-info-row"><text class="sp-info-label">销售价</text><text>{{"¥"+(part.salePrice||0)}}</text></view></view><view class="sp-actions"><button data-event-opts="{{[['tap',[['openIn',['$event']]]]]}}" class="sp-btn primary" bindtap="__e">入库</button><button data-event-opts="{{[['tap',[['openAdjust',['$event']]]]]}}" class="sp-btn" bindtap="__e">盘点</button><button data-event-opts="{{[['tap',[['goEdit',['$event']]]]]}}" class="sp-btn" bindtap="__e">编辑</button><block wx:if="{{part.status!=0}}"><button data-event-opts="{{[['tap',[['disablePart',['$event']]]]]}}" class="sp-btn danger" bindtap="__e">停用</button></block><block wx:else><button data-event-opts="{{[['tap',[['enablePart',['$event']]]]]}}" class="sp-btn" bindtap="__e">启用</button></block></view><view class="sp-section-title">出入库流水</view><view class="sp-log-list"><block wx:for="{{$root.l0}}" wx:for-item="log" wx:for-index="__i0__" wx:key="_id"><view class="sp-log-item"><view class="sp-log-head"><text class="{{['sp-log-type',log.$orig.type]}}">{{log.m0}}</text><text class="{{['sp-log-qty',(log.$orig.type=='in'||log.$orig.type=='return'||log.$orig.type=='adjust'&&log.$orig.qty>0)?'plus':'',(log.$orig.type=='out'||log.$orig.type=='adjust'&&log.$orig.qty<0)?'minus':'']}}">{{''+log.m1+''}}</text></view><view class="sp-log-meta"><text>{{log.m2}}</text><text>{{log.$orig.operatorName||'系统'}}</text></view><block wx:if="{{log.$orig.remark}}"><view class="sp-log-remark">{{log.$orig.remark}}</view></block></view></block><block wx:if="{{!$root.g0}}"><view class="sp-empty">暂无流水</view></block></view><view class="sp-bottom-space"></view></scroll-view><uni-popup class="vue-ref" vue-id="0d7ae3b6-2" type="center" data-ref="inPopup" bind:__l="__l" vue-slots="{{['default']}}"><view class="sp-popup"><view class="sp-popup-title">入库</view><view class="sp-popup-row"><text>数量</text><uni-number-box vue-id="{{('0d7ae3b6-3')+','+('0d7ae3b6-2')}}" value="{{inForm.qty}}" min="{{1}}" data-event-opts="{{[['^change',[['e0']]]]}}" bind:change="__e" bind:__l="__l"></uni-number-box></view><view class="sp-popup-row"><text>进价（元）</text><uni-easyinput bind:input="__e" vue-id="{{('0d7ae3b6-4')+','+('0d7ae3b6-2')}}" type="number" placeholder="默认成本价" value="{{inForm.unitCost}}" data-event-opts="{{[['^input',[['__set_model',['$0','unitCost','$event',[]],['inForm']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-popup-row"><text>供应商</text><uni-easyinput bind:input="__e" vue-id="{{('0d7ae3b6-5')+','+('0d7ae3b6-2')}}" placeholder="{{part.supplier||'供应商'}}" value="{{inForm.supplier}}" data-event-opts="{{[['^input',[['__set_model',['$0','supplier','$event',[]],['inForm']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-popup-row"><text>备注</text><uni-easyinput bind:input="__e" vue-id="{{('0d7ae3b6-6')+','+('0d7ae3b6-2')}}" placeholder="选填" value="{{inForm.remark}}" data-event-opts="{{[['^input',[['__set_model',['$0','remark','$event',[]],['inForm']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-popup-btns"><button data-event-opts="{{[['tap',[['closeIn',['$event']]]]]}}" class="sp-btn" bindtap="__e">取消</button><button data-event-opts="{{[['tap',[['submitIn',['$event']]]]]}}" class="sp-btn primary" bindtap="__e">确认入库</button></view></view></uni-popup><uni-popup class="vue-ref" vue-id="0d7ae3b6-7" type="center" data-ref="adjustPopup" bind:__l="__l" vue-slots="{{['default']}}"><view class="sp-popup"><view class="sp-popup-title">盘点调整</view><view class="sp-popup-row"><text>实际库存</text><uni-number-box vue-id="{{('0d7ae3b6-8')+','+('0d7ae3b6-7')}}" value="{{adjustForm.actualStock}}" min="{{0}}" data-event-opts="{{[['^change',[['e1']]]]}}" bind:change="__e" bind:__l="__l"></uni-number-box></view><view class="sp-popup-row"><text>备注</text><uni-easyinput bind:input="__e" vue-id="{{('0d7ae3b6-9')+','+('0d7ae3b6-7')}}" placeholder="盘点原因" value="{{adjustForm.remark}}" data-event-opts="{{[['^input',[['__set_model',['$0','remark','$event',[]],['adjustForm']]]]]}}" bind:__l="__l"></uni-easyinput></view><view class="sp-popup-btns"><button data-event-opts="{{[['tap',[['closeAdjust',['$event']]]]]}}" class="sp-btn" bindtap="__e">取消</button><button data-event-opts="{{[['tap',[['submitAdjust',['$event']]]]]}}" class="sp-btn primary" bindtap="__e">确认调整</button></view></view></uni-popup></view>