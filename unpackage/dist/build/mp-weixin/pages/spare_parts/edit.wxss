.sp-page{background-color:#f4f8fb;min-height:100vh}.sp-scroll{height:calc(100vh - 88px);box-sizing:border-box}.sp-form{background-color:#fff;border-radius:8px;margin:12px;padding:6px 14px}.sp-field{padding:12px 0;border-bottom:1px solid #f0f0f0}.sp-field:last-child{border-bottom:none}.sp-label{display:block;font-size:13px;color:#666;margin-bottom:8px}.sp-required{color:#ff4d4f}.sp-readonly{display:block;font-size:15px;color:#333}.sp-tip{padding:12px 0;font-size:12px;color:#999;line-height:1.6}.sp-submit-wrap{padding:10px 12px 30px}.sp-submit{background-color:#6ea0f7;font-size:15px}.sp-bottom-space{height:30px}