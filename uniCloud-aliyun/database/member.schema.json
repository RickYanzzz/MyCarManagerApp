{
	"bsonType": "object",
	"required": ["name", "phone", "enterpriseId", "cardNo"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"enterpriseId": {
			"title": "企业ID",
			"bsonType": "string",
			"foreignKey": "enterprise._id",
			"description": "会员所属企业"
		},
		"cardNo": {
			"title": "会员卡号",
			"bsonType": "string",
			"description": "企业内唯一卡号"
		},
		"name": {
			"title": "会员姓名",
			"bsonType": "string",
			"description": "会员姓名"
		},
		"phone": {
			"title": "手机号",
			"bsonType": "string",
			"description": "会员手机号"
		},
		"level": {
			"title": "会员等级",
			"bsonType": "string",
			"description": "默认为普通会员"
		},
		"balance": {
			"title": "会员余额",
			"bsonType": "int",
			"description": "当前可用余额，单位元"
		},
		"totalRecharge": {
			"title": "累计充值",
			"bsonType": "int",
			"description": "累计充值金额，单位元"
		},
		"totalConsume": {
			"title": "累计消费",
			"bsonType": "int",
			"description": "累计消费金额，单位元"
		},
		"status": {
			"title": "状态",
			"bsonType": "int",
			"description": "1 正常，0 禁用"
		},
		"remark": {
			"title": "备注",
			"bsonType": "string",
			"description": "备注信息"
		},
		"creatorUserId": {
			"title": "开卡员工ID",
			"bsonType": "string",
			"foreignKey": "user._id",
			"description": "开卡员工"
		},
		"consentMarketing": {
			"title": "同意接收服务提醒",
			"bsonType": "bool",
			"description": "营销授权。未显式关闭前按同意处理，会员详情可关闭；显式 false 的会员不会进入 AI 回访列表"
		},
		"consentAt": {
			"title": "授权时间",
			"bsonType": "timestamp",
			"description": "最后一次授权或撤回授权的时间"
		},
		"birthday": {
			"title": "生日",
			"bsonType": "string",
			"description": "MM-DD 或 YYYY-MM-DD，用于生日关怀规则（R8，二期）"
		},
		"gender": {
			"title": "性别",
			"bsonType": "int",
			"enum": [0, 1, 2],
			"description": "0 未知；1 男；2 女，用于称呼「哥/姐」"
		},
		"createTime": {
			"title": "创建时间",
			"bsonType": "timestamp"
		},
		"updateTime": {
			"title": "更新时间",
			"bsonType": "timestamp"
		}
	}
}
