<view style="background-color:#FFFFFF;height:100% !important;"><view class="context"><view style="background-color:#FFFFFF;height:500rpx;text-align:center;padding-top:100rpx;"><image style="width:294rpx;height:294rpx;border-radius:50%;" lazy-load="true" src="{{logoUrl}}"></image></view><view style="background-color:#FFFFFF;height:150rpx;text-align:center;padding:50rpx;"><input style="border-bottom:2rpx solid #d5d4d4;text-align:start;margin:50rpx 0;" placeholder="请输入用户名" data-event-opts="{{[['input',[['__set_model',['','username','$event',[]]]]]]}}" value="{{username}}" bindinput="__e"/></view><view style="background-color:#FFFFFF;text-align:center;padding:50rpx;display:flex;"><block wx:if="{{!isShow}}"><input class="password" password="true" placeholder="请输入密码" data-event-opts="{{[['input',[['__set_model',['','password','$event',[]]]]]]}}" value="{{password}}" bindinput="__e"/></block><block wx:else><input class="password" placeholder="请输入密码" data-event-opts="{{[['input',[['__set_model',['','password','$event',[]]]]]]}}" value="{{password}}" bindinput="__e"/></block><view data-event-opts="{{[['tap',[['isShowPassword',['$event']]]]]}}" class="{{['iconfont','changeShow',isShow?'icon-icon-eye-open':'icon-icon-eye-close']}}" style="{{'font-size:60rpx;'+('color:'+(themeColor)+';')}}" bindtap="__e"></view></view><view data-event-opts="{{[['tap',[['isRemeberFun',['$event']]]]]}}" class="cf-hengStart xuanShowBox" bindtap="__e"><view class="{{['iconfont','xuanShow',isRemeber?'icon-xuanzhong':'icon-weixuan']}}" style="{{'font-size:50rpx;'+(style_xuan)}}"></view><view class="xuanShowTip">记住账号密码</view></view><view data-event-opts="{{[['tap',[['loginFun',['$event']]]]]}}" style="text-align:center;margin-top:100rpx;" bindtap="__e"><view class="login" style="{{'background-color:'+(themeColor)+';'}}">登录</view></view></view></view>