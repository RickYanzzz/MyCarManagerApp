.my-grid {
  margin-top: 10px;
  margin-left: 5px;
  margin-right: 5px;
  display: flex;
  flex: 1;
  border: 0px;
}
.my-grid-item {
  display: flex;
  justify-content: center;
  align-items: center;
  border: 0px;
}
.spri-car {
  text-align: right;
  margin-right: 20px;
  margin-top: 8px;
  color: #999;
  font-size: 16px;
  font-weight: 600;
}
.chose-card {
  position: relative;
}
.chose-card .submit {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100;
  padding-left: 15px;
  padding-right: 15px;
}
.chose-card .submit .submit-btn {
  background-color: #6EA0F7;
}
